{
  "name": "@jackson-tax/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit 2>&1 || true; echo 'Server uses tsx runtime - no JS compilation needed'",
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.0.2",
    "@trpc/client": "^11.0.2",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "drizzle-orm": "^0.38.3",
    "zod": "^3.24.2",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.7",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "drizzle-kit": "^0.30.4"
  }
}