# ═══════════════════════════════════════════════════════════════
# JACKSON TAX SERVICE — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit a real `.env` file. This template contains placeholders only.
# On the server (Hostinger Node.js hosting), set these in the "Environment"
# section of the hosting panel, or upload a `.env` to the app root.
# ═══════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────
# MySQL connection string (Drizzle ORM + mysql2).
# Local dev example: mysql://user:password@127.0.0.1:3306/jackson_tax_service
# Hostinger example:  mysql://username:password@localhost:3306/jackson_tax_service
DATABASE_URL=mysql://user:password@localhost:3306/jackson_tax_service

# ─── Authentication / Security ─────────────────────────────────
# REQUIRED in production. Generate a secure random string (32+ bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars

# Manus OAuth (optional — for social login). Leave blank to use built-in JWT auth.
OAUTH_CLIENT_ID=your_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# ─── File Storage (S3-compatible) ──────────────────────────────
# Optional. Used for document uploads, certificate PDFs, and media.
# If using the local filesystem instead, leave these blank.
AWS_ACCESS_KEY_ID=your_aws_or_s3_compatible_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_s3_compatible_secret_key
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com

# ─── Calendly ──────────────────────────────────────────────────
# Optional. Basic booking links (https://calendly.com/ajackstaxservice) work
# without this; set it only for advanced Calendly API features.
CALENDLY_API_KEY=

# ─── Email / Notifications (SMTP) ──────────────────────────────
# Used to send contact-form submissions and notifications (new student
# registrations, approvals, new comments, certificate issuance).
# Hostinger provides free email accounts — use those credentials.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=you@ajackstax.com
# SMTP_PASS=your_email_password
# ADMIN_EMAIL=ajackstaxservice@gmail.com

# ─── Application ───────────────────────────────────────────────
# development | production
NODE_ENV=development
# Server port (client Vite dev server runs on 5173; server on this port).
PORT=3001
# Client origin, used for CORS and redirects. In production this is the domain.
CLIENT_URL=http://localhost:5173

# ─── Client (Vite) build-time variables ────────────────────────
# These are baked into the client bundle at build time (prefix VITE_).
# They only change on the next `npm run build`.
VITE_API_URL=http://localhost:3001
# Google Analytics measurement ID (optional).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ═══════════════════════════════════════════════════════════════
# QUICK START
# ═══════════════════════════════════════════════════════════════
# 1. Create a MySQL database and set DATABASE_URL.
# 2. Set JWT_SECRET (required in production).
# 3. Run:  npm run db:push    (creates tables from Drizzle schema)
# 4. Run:  npm run seed       (populates sample data)
# 5. Run:  npm run dev        (starts server + client)
# 6. Run:  npm run build      (production client build → client/dist)
# ═══════════════════════════════════════════════════════════════
